<?xml version="1.0" encoding="utf-8"?>
<Application
    x:Class="Obhijatri.App.App"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <XamlControlsResources xmlns="using:Microsoft.UI.Xaml.Controls" />
            </ResourceDictionary.MergedDictionaries>

            <!--
                অভিযাত্রী's default look: a red accent (from the current flag), a dark green tab
                strip, and gold used only as a small "sun" accent (a nod to the gold map on the
                original 1971 flag). The accent colours below override the six tones WinUI's controls
                (buttons, toggles, hyperlinks, focus visuals) read via ThemeResource, so they apply
                automatically in both light and dark mode; nothing here is set once in code.
            -->
            <Color x:Key="SystemAccentColor">#F42A41</Color>
            <Color x:Key="SystemAccentColorLight1">#F65A6E</Color>
            <Color x:Key="SystemAccentColorLight2">#F98793</Color>
            <Color x:Key="SystemAccentColorLight3">#FCB3BA</Color>
            <Color x:Key="SystemAccentColorDark1">#C71F35</Color>
            <Color x:Key="SystemAccentColorDark2">#9A1729</Color>
            <Color x:Key="SystemAccentColorDark3">#6D0F1D</Color>

            <!-- The tab strip band: one dark green, deliberately the same in both themes (like a
                 browser's own brand colour), so this is a plain resource, not a ThemeResource. -->
            <SolidColorBrush x:Key="ObhijatriTabStripBackgroundBrush" Color="#0B3D2C" />
            <SolidColorBrush x:Key="ObhijatriGoldAccentBrush" Color="#D4AF37" />

            <Style x:Key="ToolbarButtonStyle" TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
                <Setter Property="Width" Value="36" />
                <Setter Property="Height" Value="32" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Theme-aware styles for UI built in code: ThemeResource setters follow light/dark changes. -->
            <Style x:Key="SettingsCardStyle" TargetType="Border">
                <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
                <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="16" />
            </Style>
            <Style x:Key="SecondaryCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="SuccessCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorSuccessBrush}" />
            </Style>
            <Style x:Key="PhoneticOnTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="15" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{ThemeResource AccentTextFillColorPrimaryBrush}" />
            </Style>
            <Style x:Key="PhoneticOffTextStyle" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
            </Style>
            <Style x:Key="CriticalCaptionTextBlockStyle" TargetType="TextBlock" BasedOn="{StaticResource CaptionTextBlockStyle}">
                <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
