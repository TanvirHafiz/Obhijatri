<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Obhijatri.App.Views.ReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Controls. Labels are set in code from the resource files. -->
        <Grid Grid.Row="0" Padding="12,8" ColumnSpacing="8"
              BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}" BorderThickness="0,0,0,1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button x:Name="PlayButton" Grid.Column="0" Click="PlayButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon x:Name="PlayIcon" Glyph="&#xE768;" FontSize="14" />
                    <TextBlock x:Name="PlayText" />
                </StackPanel>
            </Button>
            <Button x:Name="StopButton" Grid.Column="1" Click="StopButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE71A;" FontSize="14" />
                    <TextBlock x:Name="StopText" />
                </StackPanel>
            </Button>
            <Button x:Name="TranslateButton" Grid.Column="2" Visibility="Collapsed" Click="TranslateButton_Click">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE774;" FontSize="14" />
                    <TextBlock x:Name="TranslateText" />
                </StackPanel>
            </Button>
            <TextBlock x:Name="StatusText" Grid.Column="3" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"
                       Style="{StaticResource SecondaryCaptionTextBlockStyle}" />
            <Button x:Name="SmallerButton" Grid.Column="4" Click="SmallerButton_Click">
                <FontIcon Glyph="&#xE738;" FontSize="14" />
            </Button>
            <Button x:Name="LargerButton" Grid.Column="5" Click="LargerButton_Click">
                <FontIcon Glyph="&#xE710;" FontSize="14" />
            </Button>
            <Button x:Name="CloseButton" Grid.Column="6" Click="CloseButton_Click">
                <FontIcon Glyph="&#xE711;" FontSize="14" />
            </Button>
        </Grid>

        <!-- Shown when Windows has no Bangla voice. -->
        <InfoBar x:Name="NoVoiceBar" Grid.Row="1" Severity="Informational" IsOpen="False" IsClosable="True">
            <InfoBar.ActionButton>
                <Button x:Name="SpeechSettingsButton" Click="SpeechSettingsButton_Click" />
            </InfoBar.ActionButton>
        </InfoBar>

        <ScrollViewer x:Name="ArticleScroller" Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <Grid MaxWidth="760" Padding="24,20,24,48">
                <StackPanel x:Name="ArticlePanel" Spacing="6" />
            </Grid>
        </ScrollViewer>
    </Grid>
</UserControl>
