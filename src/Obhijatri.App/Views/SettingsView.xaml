<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="Obhijatri.App.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="{ThemeResource SolidBackgroundFillColorBaseBrush}">

    <NavigationView x:Name="Nav"
                    PaneDisplayMode="Left"
                    IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False"
                    IsPaneToggleButtonVisible="False"
                    OpenPaneLength="240"
                    SelectionChanged="Nav_SelectionChanged">
        <ScrollViewer x:Name="SectionScroller" HorizontalScrollMode="Disabled">
            <StackPanel MaxWidth="820" Padding="32,24,32,32" Spacing="8">
                <TextBlock x:Name="SectionTitle" Style="{StaticResource TitleTextBlockStyle}" Margin="0,0,0,12" />
                <ContentPresenter x:Name="SectionHost" />
            </StackPanel>
        </ScrollViewer>
    </NavigationView>
</UserControl>
